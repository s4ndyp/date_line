{
	"name": "date-line",
	"version": "0.3.7",
	"description": "Obsidian plugin: datums herkennen, stylen en bewerken met een kalender.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": ["obsidian", "obsidian-plugin", "date", "calendar"],
	"license": "MIT",
	"dependencies": {
		"vanillajs-datepicker": "^1.3.4"
	},
	"devDependencies": {
		"@types/vanillajs-datepicker": "^1.3.4",
		"@codemirror/language": "^6.11.2",
		"@codemirror/view": "^6.38.1",
		"@types/node": "^20.14.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.0",
		"obsidian": "latest",
		"tslib": "2.6.3",
		"typescript": "5.5.4"
	}
}
